    <Cell ss:StyleID="HeaderStyle"><Data ss:Type="String">Thông số kiến trúc CPU</Data></Cell>
    <Cell ss:StyleID="HeaderStyle"><Data ss:Type="String">Giá trị chi tiết</Data></Cell>
   </Row>
   <Row><Cell ss:StyleID="DataText"><Data ss:Type="String">Bộ vi xử lý (CPU)</Data></Cell><Cell ss:StyleID="DataText"><Data ss:Type="String">AMD Ryzen 7 6800H with Radeon Graphics</Data></Cell></Row>
   <Row><Cell ss:StyleID="DataText"><Data ss:Type="String">Số nhân vật lý (Physical Cores)</Data></Cell><Cell ss:StyleID="DataInteger"><Data ss:Type="Number">8</Data></Cell></Row>
   <Row><Cell ss:StyleID="DataText"><Data ss:Type="String">Số luồng logic (Logical Processors)</Data></Cell><Cell ss:StyleID="DataInteger"><Data ss:Type="Number">16</Data></Cell></Row>
   <Row><Cell ss:StyleID="DataText"><Data ss:Type="String">L1 Data Cache (mỗi nhân)</Data></Cell><Cell ss:StyleID="DataText"><Data ss:Type="String">32 KB (Khối Tile1 khuyến nghị: 32 - 64)</Data></Cell></Row>
   <Row><Cell ss:StyleID="DataText"><Data ss:Type="String">L2 Cache (mỗi nhân)</Data></Cell><Cell ss:StyleID="DataText"><Data ss:Type="String">512 KB (Khối Tile2 khuyến nghị: 64 - 128)</Data></Cell></Row>
   <Row><Cell ss:StyleID="DataText"><Data ss:Type="String">L3 Cache (chia sẻ dùng chung)</Data></Cell><Cell ss:StyleID="DataText"><Data ss:Type="String">16 MB (Khối Tile3 khuyến nghị: 256 - 512)</Data></Cell></Row>
   <Row><Cell ss:StyleID="DataText"><Data ss:Type="String">Mô hình bộ nhớ</Data></Cell><Cell ss:StyleID="DataText"><Data ss:Type="String">SMP Shared Memory (Fork-Join OpenMP)</Data></Cell></Row>
   <Row><Cell ss:StyleID="DataText"><Data ss:Type="String">Tập lệnh vector hóa</Data></Cell><Cell ss:StyleID="DataText"><Data ss:Type="String">AVX2 + FMA3 (256-bit SIMD registers)</Data></Cell></Row>
   <Row><Cell ss:StyleID="DataText"><Data ss:Type="String">Định luật Amdahl (Mục 3.5)</Data></Cell><Cell ss:StyleID="DataText"><Data ss:Type="String">Speedup = 1 / ( (1 - p) + p / q )</Data></Cell></Row>
